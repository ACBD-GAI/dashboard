# Public browser configuration. The anon/publishable key is safe for browser use
# only when Row-Level Security policies are enabled and reviewed.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server/migration tooling only. Never prefix these with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Short-lived authenticated admin access token for an explicitly confirmed
# legacy migration write. Dry-run mode does not require this value.
SUPABASE_MIGRATION_ACCESS_TOKEN=
